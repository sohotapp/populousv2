# ===========================================
# RLTX Decision Compiler - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# DATABASE (Neon.tech)
# ===========================================
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech:5432/rltx?sslmode=require

# ===========================================
# REDIS (Upstash)
# ===========================================
# Get this from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
# Get this from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===========================================
# AI - ANTHROPIC (Claude)
# ===========================================
# Get this from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# ===========================================
# AI - OPENAI (Embeddings)
# ===========================================
# Get this from: https://platform.openai.com
OPENAI_API_KEY=sk-xxx

# ===========================================
# VECTOR DATABASE (Pinecone)
# ===========================================
# Get this from: https://app.pinecone.io
PINECONE_API_KEY=xxx
PINECONE_INDEX=rltx-templates
PINECONE_ENVIRONMENT=us-east-1

# ===========================================
# STORAGE (Cloudflare R2)
# ===========================================
# Get this from: https://dash.cloudflare.com
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=rltx-artifacts

# ===========================================
# WEBSOCKET SERVER (Optional)
# ===========================================
SOCKET_SERVER_URL=http://localhost:3001

# ===========================================
# MONITORING (Optional)
# ===========================================
# Sentry: https://sentry.io
SENTRY_DSN=
# PostHog: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
