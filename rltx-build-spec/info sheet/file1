## Technical Implementation

### The DAG Engine

```python
class SimulationDAG:
    def __init__(self):
        self.nodes = {}
        self.edges = []
        self.results = {}
    
    def add_node(self, node_id: str, node: SimNode):
        self.nodes[node_id] = node
    
    def add_edge(self, from_id: str, to_id: str):
        self.edges.append((from_id, to_id))
    
    def execute(self, parallel: bool = True) -> Dict:
        # Topological sort to get execution order
        execution_order = self.topological_sort()
        
        # Group nodes by level for parallel execution
        levels = self.group_by_level(execution_order)
        
        for level in levels:
            if parallel:
                # Run all nodes at this level in parallel
                futures = []
                for node_id in level:
                    node = self.nodes[node_id]
                    inputs = self.gather_inputs(node_id)
                    future = executor.submit(node.run, inputs)
                    futures.append((node_id, future))
                
                # Collect results
                for node_id, future in futures:
                    self.results[node_id] = future.result()
            else:
                # Sequential execution
                for node_id in level:
                    node = self.nodes[node_id]
                    inputs = self.gather_inputs(node_id)
                    self.results[node_id] = node.run(inputs)
        
        return self.results
    
    def gather_inputs(self, node_id: str) -> Dict:
        # Get results from parent nodes
        inputs = {}
        for from_id, to_id in self.edges:
            if to_id == node_id:
                inputs[from_id] = self.results.get(from_id)
        return inputs
```

### Handling Unknown Unknowns

When uncertainty is deep, you run **sensitivity analysis**:

```python
class SensitivityAnalyzer:
    def run(self, dag: SimulationDAG, base_result: DeepResult) -> SensitivityReport:
        sensitivities = {}
        
        # For each input parameter
        for param in dag.get_parameters():
            # Vary the parameter
            variations = self.generate_variations(param)
            
            results = []
            for variation in variations:
                dag.set_parameter(param, variation)
                result = dag.execute()
                results.append(result)
            
            # Calculate sensitivity
            sensitivity = self.calculate_sensitivity(
                param, variations, results
            )
            sensitivities[param] = sensitivity
        
        # Identify critical uncertainties
        critical = [
            p for p, s in sensitivities.items() 
            if s.impact > threshold
        ]
        
        return SensitivityReport(
            sensitivities=sensitivities,
            critical_uncertainties=critical,
            recommendation=self.generate_recommendation(critical)
        )
```

