## The Orchestration Layer

You need a system that manages the whole DAG:

```python
class SimulationOrchestrator:
    def __init__(self):
        self.dag = SimulationDAG()
        self.results_store = ResultsStore()
        
    def run_deep_prediction(self, question: str) -> DeepResult:
        # 1. Decompose the question
        root = DecompositionNode()
        sub_questions = root.run(question)
        
        # 2. Build the DAG
        for sq in sub_questions:
            node = self.create_node(sq)
            self.dag.add(node)
            
            # Add counterfactual branches if needed
            if sq.has_uncertainty:
                branches = CounterfactualNode().run(sq.scenario)
                for branch in branches:
                    self.dag.add_branch(node, branch)
        
        # 3. Execute DAG (parallel where possible)
        results = self.dag.execute(parallel=True)
        
        # 4. Synthesize results
        synthesis = self.synthesize(results)
        
        return DeepResult(
            answer=synthesis.answer,
            confidence=synthesis.confidence,
            key_drivers=synthesis.causal_factors,
            counterfactuals=synthesis.branches,
            uncertainty_breakdown=synthesis.uncertainty
        )
```

